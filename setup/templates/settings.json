{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "claude-sonnet-4-6",
  "effortLevel": "high",
  "defaultMode": "acceptEdits",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,

  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet run *)",
      "Bash(dotnet watch *)",
      "Bash(dotnet publish *)",
      "Bash(dotnet clean *)",
      "Bash(dotnet format *)",
      "Bash(dotnet list package *)",
      "Bash(dotnet ef migrations list *)",
      "Bash(dotnet ef migrations script *)",
      "Bash(dotnet ef dbcontext info *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash list *)",
      "Bash(git remote -v)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(dotnet ef migrations add *)",
      "Bash(dotnet ef database update *)",
      "Bash(dotnet ef database drop *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/appsettings.Production.json)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh 2>/dev/null || pwsh -NoProfile -File .claude/scripts/session-start.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-end.sh 2>/dev/null || pwsh -NoProfile -File .claude/scripts/session-end.ps1"
          }
        ]
      }
    ]
  },

  "env": {
    "DOTNET_ENVIRONMENT": "Development",
    "DOTNET_WATCH_SUPPRESS_EMOJIS": "1"
  },

  "cleanupPeriodDays": 30
}
